<Window x:Class="Undefined.StringDumper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Undefined String Dumper"
        Icon="Assets/logo.png"
        Width="1380"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#0E1012" />
        </Style>

        <Style x:Key="ProcessMetadataLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="ProcessMetadataValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ProcessListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="ProcessItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="13"
                                Background="#0C0E10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A1916" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#0B0D0F" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0E1012" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#171A1E" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#25231D" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="#22252A" />
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#08090A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            Background="#101214"
                            CornerRadius="8">
                        <Image Margin="2"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="Assets/logo.png"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Undefined String Dumper" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   Text="MEMORY  ·  FORENSICS  ·  EVIDENCE" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" />
                    <TextBlock Margin="8,0,22,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Text="上传通道未配置 · 本地零持久化" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="MinimizeButton_Click" Content="—" Style="{StaticResource ChromeButtonStyle}" />
                    <Button Click="MaximizeButton_Click" Content="□" Style="{StaticResource ChromeButtonStyle}" />
                    <Button Click="CloseButton_Click" Content="×" Style="{StaticResource ChromeButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="342" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="285" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="01  TARGET PROCESS" />
                                <TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Text="选择游戏进程" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinHeight="34"
                                    Padding="11,0"
                                    Command="{Binding RefreshCommand}"
                                    Content="{Binding RefreshButtonText}"
                                    Style="{StaticResource BaseButtonStyle}" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,9,0,14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="仅列出 java.exe 与 javaw.exe，请核对 PID。"
                                   TextWrapping="Wrap" />

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Processes}"
                                 ItemContainerStyle="{StaticResource ProcessItemStyle}"
                                 SelectedItem="{Binding SelectedProcess}"
                                 Style="{StaticResource ProcessListStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding PathLabel}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ProcessLabel}" />
                                            <TextBlock Grid.Column="1"
                                                       Foreground="{StaticResource GoldBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Text="{Binding ProcessIdLabel}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource SoftBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Text="{Binding CurrentDirectoryLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentDirectoryLabel}" />
                                        <Grid Grid.Row="3" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{StaticResource SoftBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Text="{Binding MemoryLabel}" />
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"
                                                       Text="{Binding StartedLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StartedLabel}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="3"
                                Margin="0,12,0,0"
                                Padding="11"
                                Background="#0B0D0F"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Text="若列表为空，请先进入游戏主界面后刷新。"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="02  SCAN PROFILE" />
                        <TextBlock Margin="0,8,0,14" FontSize="18" FontWeight="SemiBold" Text="字符串规则" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="最短字符串长度" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           Text="与示例一致，默认 4" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     HorizontalContentAlignment="Center"
                                     Text="{Binding MinimumLength, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox Margin="0,0,18,8" Content="ASCII" IsChecked="{Binding DetectAscii}" />
                            <CheckBox Margin="0,0,0,8"
                                      Content="Unicode（PH 兼容）"
                                      IsChecked="{Binding DetectUnicode}"
                                      ToolTip="识别由零字节分隔的宽字符串，与 Process Hacker 2.39 的 Detect Unicode 规则一致" />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Margin="0,0,18,8" Content="Private" IsChecked="{Binding IncludePrivate}" />
                            <CheckBox Margin="0,0,18,8" Content="Mapped" IsChecked="{Binding IncludeMapped}" />
                            <CheckBox Margin="0,0,0,8" Content="Image" IsChecked="{Binding IncludeImage}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="03  MEMORY ACQUISITION" />
                            <TextBlock Margin="0,9,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedProcessTitle}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SelectedProcessSubtitle}" />
                            <CheckBox Margin="0,16,0,0"
                                      IsChecked="{Binding ConsentConfirmed}">
                                <TextBlock Foreground="{StaticResource SoftBrush}"
                                           FontSize="11"
                                           Text="我确认已获得玩家授权，并仅将结果用于本次查端取证。"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="18,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0"
                                    Command="{Binding StartScanCommand}"
                                    Content="{Binding PrimaryActionText}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Grid.Row="2"
                                    Command="{Binding CancelCommand}"
                                    Content="停止扫描"
                                    Style="{StaticResource DangerButtonStyle}" />
                        </Grid>

                        <Border Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Padding="13,11"
                                Background="#0B0D0F"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding HasSelectedProcess, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource ProcessMetadataLabelStyle}" Text="文件说明" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.DescriptionLabel}"
                                           ToolTip="{Binding SelectedProcess.DescriptionLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource ProcessMetadataLabelStyle}" Text="文件版本" />
                                <TextBlock Grid.Row="0" Grid.Column="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.FileVersionLabel}"
                                           ToolTip="{Binding SelectedProcess.FileVersionLabel}" />

                                <TextBlock Grid.Row="1" Style="{StaticResource ProcessMetadataLabelStyle}" Text="数字签名" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.SignatureLabel}"
                                           ToolTip="{Binding SelectedProcess.SignatureLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ProcessMetadataLabelStyle}" Text="启动时间" />
                                <TextBlock Grid.Row="1" Grid.Column="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.StartedLabel}"
                                           ToolTip="{Binding SelectedProcess.StartedLabel}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource ProcessMetadataLabelStyle}" Text="映像路径" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.PathLabel}"
                                           ToolTip="{Binding SelectedProcess.PathLabel}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource ProcessMetadataLabelStyle}" Text="命令行" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.CommandLineLabel}"
                                           ToolTip="{Binding SelectedProcess.CommandLineLabel}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource ProcessMetadataLabelStyle}" Text="当前目录" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.CurrentDirectoryLabel}"
                                           ToolTip="{Binding SelectedProcess.CurrentDirectoryLabel}" />

                                <TextBlock Grid.Row="5" Style="{StaticResource ProcessMetadataLabelStyle}" Text="PEB 地址" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.PebAddressLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource ProcessMetadataLabelStyle}" Text="映像类型" />
                                <TextBlock Grid.Row="5" Grid.Column="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.ImageTypeLabel}" />

                                <TextBlock Grid.Row="6" Style="{StaticResource ProcessMetadataLabelStyle}" Text="父进程" />
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.ParentProcessLabel}"
                                           ToolTip="{Binding SelectedProcess.ParentProcessLabel}" />
                                <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource ProcessMetadataLabelStyle}" Text="保护级别" />
                                <TextBlock Grid.Row="6" Grid.Column="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.ProtectionLabel}" />

                                <TextBlock Grid.Row="7" Style="{StaticResource ProcessMetadataLabelStyle}" Text="缓解策略" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="4"
                                           Style="{StaticResource ProcessMetadataValueStyle}"
                                           Text="{Binding SelectedProcess.MitigationPoliciesLabel}"
                                           ToolTip="{Binding SelectedProcess.MitigationPoliciesLabel}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="REGIONS" />
                            <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="18" Text="{Binding RegionsMetric}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="DATA READ" />
                            <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="18" Text="{Binding DataMetric}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="STRINGS" />
                            <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="18" Text="{Binding StringsMetric}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="ELAPSED" />
                            <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="18" Text="{Binding DurationMetric}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Padding="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="内存字符串预览" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10">
                                    <Run Text="当前展示 " />
                                    <Run Foreground="{StaticResource SoftBrush}" Text="{Binding PreviewMetric, Mode=OneWay}" />
                                    <Run Text=" 条" />
                                </TextBlock>
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按字符串内容或内存地址筛选" />
                            <Button Grid.Column="3"
                                    MinHeight="36"
                                    VerticalAlignment="Center"
                                    Command="{Binding ExportCommand}"
                                    Content="{Binding ExportActionText}"
                                    Style="{StaticResource BaseButtonStyle}"
                                    ToolTip="重新读取当前目标并把全部结果导出到所选文件" />
                            <Button Grid.Column="5"
                                    MinHeight="36"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearResultsCommand}"
                                    Content="清除预览"
                                    Style="{StaticResource BaseButtonStyle}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="18,0,18,12"
                                Padding="12,10"
                                Background="#251516"
                                BorderBrush="#633435"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#FFAAA7" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="2" Margin="18,0,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           Text="{Binding StatusDetail}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="{Binding ProgressPercentText}" />
                        </Grid>

                        <ProgressBar Grid.Row="2"
                                     Margin="18,48,18,0"
                                     VerticalAlignment="Bottom"
                                     Maximum="1"
                                     Value="{Binding ProgressFraction, Mode=OneWay}" />

                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding ResultsView}"
                                  AutoGenerateColumns="False"
                                  AlternationCount="2"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="130"
                                                    Binding="{Binding AddressText}"
                                                    Header="ADDRESS"
                                                    ElementStyle="{StaticResource MonoCellStyle}" />
                                <DataGridTextColumn Width="80" Binding="{Binding Length}" Header="LENGTH" />
                                <DataGridTextColumn Width="92" Binding="{Binding EncodingText}" Header="ENCODING" />
                                <DataGridTextColumn Width="90" Binding="{Binding RegionText}" Header="REGION" />
                                <DataGridTextColumn Width="*" Binding="{Binding Value}" Header="RESULT" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="4"
                                Padding="14,10"
                                Background="#0B0D0F"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Text="{Binding PreviewNotice}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#08090A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"
                           Text="UNDEFINED SS COMMUNITY  ·  FAIRNESS  /  FORENSICS  /  TRUST" />
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"
                           Text="SESSION-ONLY PREVIEW" />
            </Grid>
        </Border>
    </Grid>
</Window>
